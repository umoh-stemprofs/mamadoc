{
  "name": "mamadoc",
  "version": "0.1.0",
  "private": true,
  "description": "MamaDoc — maternal triage and priority booking (Health track prototype)",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "verify:constraints": "tsx scripts/verify-double-booking.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.10",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
