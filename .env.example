# MamaDoc environment template.
# Copy to .env and fill in real values. .env is git-ignored — never commit or print real values.

# Neon Postgres connection string (team secret)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# AES-256-GCM key for health profile/file encryption: 32 random bytes, base64
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HEALTH_DATA_KEY=replace-with-32-random-bytes-base64

# Session cookie secret: 32 random bytes, base64
SESSION_SECRET=replace-with-32-random-bytes-base64

# Nigerian national emergency number (confirm locally before release)
EMERGENCY_NUMBER=112

# Timezone for all dates and times
APP_TZ=Africa/Lagos

# Show "Try demo" buttons once the screens exist
DEMO_MODE=true
